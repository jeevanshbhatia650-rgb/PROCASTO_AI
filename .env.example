# Accounts (Supabase). Leave empty to run the site as an open demo with no sign-in.
SUPABASE_URL=
# Public by design: it is sent to every browser. Row-level security protects the data.
SUPABASE_PUBLISHABLE_KEY=
# Encrypts SmartThings tokens before they are stored. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later means every user has to connect SmartThings again.
TOKEN_ENCRYPTION_KEY=
# The conversation and phrasing: fake (templates only, no key needed) | gemini (the model tiers below)
LLM_PROVIDER=fake
GEMINI_API_KEY=
# Optional extra free tiers, used only when their key is set
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
# provider:model, tried in order. Each model has its own free quota; one that fails rests and the next answers.
LLM_TIERS=gemini:gemini-3.1-flash-lite,gemini:gemma-4-26b-a4b-it,gemini:gemini-3.5-flash-lite,gemini:gemini-flash-lite-latest,gemini:gemma-4-31b-it,groq:llama-3.3-70b-versatile,openrouter:meta-llama/llama-3.3-70b-instruct:free,hf:openai/gpt-oss-20b
# Per model before it rests; after LLM_HEDGE_MS the next tier races alongside it
LLM_TIER_TIMEOUT_MS=8000
LLM_HEDGE_MS=2000
# SmartThings (per user, from Integrations). Register an API Access app in the SmartThings Developer Workspace.
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=http://localhost:8000/auth/smartthings/callback
# Public https URL SmartThings can reach for webhooks (use a tunnel in dev)
PUBLIC_BASE_URL=
# Where the SmartThings login sends people back to: this site's public URL
FRONTEND_URL=http://localhost:5180
# Real devices only; demo-home commands always work
ALLOW_COMMANDS=false
# Simulated homes for signed-out visitors, one each
MAX_DEMO_HOMES=50
CLAUSE_STABILITY_N=2
TASK_TIMEOUT_MS=3000
LLM_TIMEOUT_MS=2500
# false = BM25 only, no model download
DENSE_SEARCH=true
# Optional: only answer Alexa requests for this skill id
ALEXA_SKILL_ID=
# Hosting the website separately (e.g. Vercel): allow its origin, and trust one proxy hop (Render, ngrok)
# so per-visitor limits see real visitor addresses.
CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]
CORS_ORIGIN_REGEX=
TRUSTED_PROXY_HOPS=0
