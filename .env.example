# Device source: sim | smartthings
DEVICE_PROVIDER=sim
# Phrasing: fake (templates only, no key needed) | gemini
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=http://localhost:8000/auth/smartthings/callback
# Public https URL SmartThings can reach for webhooks (use a tunnel in dev)
PUBLIC_BASE_URL=
# Real devices only; simulator commands always work
ALLOW_COMMANDS=false
CLAUSE_STABILITY_N=2
TASK_TIMEOUT_MS=3000
LLM_TIMEOUT_MS=1500
# false = BM25 only, no model download
DENSE_SEARCH=true
# Where the SmartThings login sends you back to (the frontend)
FRONTEND_URL=http://localhost:5180
# Optional: only answer Alexa requests for this skill id
ALEXA_SKILL_ID=
